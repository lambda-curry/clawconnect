{
  "name": "chatgpt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "ChatGPT MCP integration for OpenClaw with live progress widget",
  "author": "Jake Ruesink",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/build-widget.mjs",
    "start": "node dist/index.js",
    "restart": "lsof -ti:7331 | xargs kill -9 2>/dev/null; pnpm run build && node dist/index.js"
  },
  "dependencies": {
    "@clawconnect/core": "workspace:*",
    "@clawconnect/mcp": "workspace:*",
    "@hono/node-server": "^1.19.12",
    "@modelcontextprotocol/ext-apps": "^1.3.2",
    "@modelcontextprotocol/node": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "dotenv": "^17.3.1",
    "hono": "^4.12.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "catalog:",
    "tsx": "^4.7.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
